# ==========================================
# HOTBEE Commerce Platform - Environment Configuration
# ==========================================
# Copy to .env.local for local development, and set the same values in
# Netlify -> Site settings -> Environment variables for production.
#
# The app runs in demo mode when keys are missing and switches to live
# services automatically once they are provided.

# --- Admin access ---
# The PIN is checked on the server; it never reaches the browser bundle.
ADMIN_PIN=change-this-pin
# Signs the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# --- Supabase Database & Storage ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Used for catalogue writes and design uploads. Never expose this.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Razorpay Payment Gateway ---
# Test keys start with rzp_test_, live keys with rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Qikink Print-on-Demand API ---
QIKINK_API_KEY=your_qikink_client_id
QIKINK_API_SECRET=your_qikink_client_secret
# Sandbox: https://sandbox.qikink.com/api  |  Production: https://api.qikink.com/api
QIKINK_BASE_URL=https://sandbox.qikink.com/api

# --- Email Notifications (Resend, optional) ---
RESEND_API_KEY=re_your_resend_api_key

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=1234567890
